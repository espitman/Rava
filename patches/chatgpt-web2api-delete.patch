+    async def _handle_delete_conversation(self, request: web.Request) -> web.Response:
+        if err := self._check_auth(request):
+            return err
+        conversation_id = request.match_info.get("conversation_id", "").strip()
+        if not conversation_id:
+            return web.json_response(
+                {
+                    "error": {
+                        "message": "Conversation ID is required",
+                        "type": "invalid_request_error",
+                    }
+                },
+                status=400,
+            )
+        try:
+            if self._parallel_tabs:
+                port, key = resolve_mutation_lock(self._driver, True)
+            else:
+                port, key = self._cdp_port, None
+            async with MutationLock(port, key):
+                deleted = await self._driver.delete_conversation(conversation_id)
+            if not deleted:
+                return web.json_response(
+                    {
+                        "error": {
+                            "message": "ChatGPT did not delete the conversation",
+                            "type": "delete_failed",
+                        }
+                    },
+                    status=502,
+                )
+            if self._last_conv_id == conversation_id:
+                self._last_conv_id = None
+                self._last_project_id = None
+            return web.Response(status=204)
+        except Exception as e:
+            logger.error("Conversation deletion failed: %s", e, exc_info=True)
+            return self._error_response(e)
+
