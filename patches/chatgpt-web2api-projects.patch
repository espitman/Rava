+    async def _handle_create_project(self, request: web.Request) -> web.Response:
+        if err := self._check_auth(request):
+            return err
+        try:
+            body = await request.json()
+        except json.JSONDecodeError:
+            return web.json_response(
+                {"error": {"message": "Invalid JSON", "type": "invalid_request_error"}},
+                status=400,
+            )
+        name = str(body.get("name", "")).strip()
+        if not name:
+            return web.json_response(
+                {"error": {"message": "Project name is required", "type": "invalid_request_error"}},
+                status=400,
+            )
+        projects = await self._driver.get_projects()
+        for project in projects:
+            if str(project.get("name", "")).casefold() == name.casefold():
+                return web.json_response(project)
+        result = await self._driver.create_project(
+            name=name,
+            instructions=str(body.get("instructions", "")),
+            memory_scope=str(body.get("memory_scope", "project_v2")),
+        )
+        if result.get("error"):
+            return web.json_response(
+                {"error": {"message": str(result["error"]), "type": "project_creation_error"}},
+                status=502,
+            )
+        return web.json_response(result, status=201)
+
